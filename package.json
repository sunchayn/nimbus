{
    "private": true,
    "version": "0.9.0-alpha",
    "type": "module",
    "scripts": {
        "check:theme": "node tools/ui/check-theme.js",
        "style:check": "npm run check:theme && eslint --config tools/eslint/eslint.config.js resources/js",
        "style:fix": "npm run style:check -- --fix",
        "type:check": "vue-tsc --noEmit --project tsconfig.json",
        "vite": "vite --config vite.config.js",
        "build": "npm run type:check && npm run vite -- build && cp -a ./resources/dist-static/. ./resources/dist",
        "build:dev": "npm run vite -- build --mode=development && cp -a ./resources/dist-static/. ./resources/dist",
        "dev": "npm run vite -- dev",
        "test": "vitest --config resources/js/tests/vitest.config.ts",
        "test:ui": "npm run test -- --ui",
        "test:run": "npm run test -- run",
        "test:coverage": "npm run test:run --coverage",
        "test:watch": "npm run test -- --watch",
        "test:snapshot": "npm run test:run --reporter=verbose --update",
        "test:e2e": "npx playwright test -c ./tests/E2E/playwright.config.ts",
        "test:e2e:ui": "npm run test:e2e -- --ui"
    },
    "devDependencies": {
        "@iconify-json/hugeicons": "^1.2.36",
        "@nuxt/ui": "^4.12.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/user-event": "^14.6.10",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/ui": "^5.1.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vueuse/core": "^15.0.0",
        "axios": "^1.21.1",
        "clsx": "^2.1.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-vue": "^10.12.1",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vue": "^3.5.45",
        "vue-eslint-parser": "^10.4.2",
        "vue-router": "^5.5.1",
        "vue-tsc": "^3.3.14"
    },
    "dependencies": {
        "@codemirror/lang-json": "^6.0.1",
        "@codemirror/lint": "^6.8.4",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.6.0",
        "@pinia/testing": "^2.0.2",
        "@types/json-schema": "^7.0.15",
        "codemirror": "^6.0.1",
        "codemirror-json-schema": "^0.8.0",
        "concurrently": "^10.0.7",
        "eslint-plugin-import-x": "^4.18.1",
        "globals": "^17.14.0",
        "jsonc-parser": "^3.3.1",
        "pako": "^3.0.3",
        "pinia": "^4.1.0",
        "pinia-plugin-persistedstate": "^4.7.1",
        "pretty-bytes": "^7.2.0",
        "pretty-ms": "^10.0.0",
        "reka-ui": "^2.7.0",
        "tw-animate-css": "^1.3.8",
        "typescript-eslint": "^8.72.2",
        "uuid": "^14.0.3",
        "vue-codemirror": "^6.1.1",
        "vuedraggable": "^4.1.0"
    },
    "overrides": {
        "glob": "^14.0.6",
        "minimatch": "^11.0.8"
    }
}
